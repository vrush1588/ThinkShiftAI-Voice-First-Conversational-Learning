# ThinkShift AI backend — copy to .env and fill in your values.
#   cp .env.example .env
# Never commit .env (it is already in .gitignore).

# ── Agora project (Agora Console → Project Management) ───────────────────
# Required. 32-character App ID and App Certificate.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERT=your_agora_app_certificate

# ── Agora RESTful API credentials (Agora Console → RESTful API) ───────────
# Used for /interrupt-agent and for /stop-agent when the agent session is
# no longer in server memory (e.g. after a backend restart).
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# ── Homework photo (Gemini vision) ────────────────────────────────────────
# Required for /analyze-homework. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional (default shown)
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Region ────────────────────────────────────────────────────────────────
# US | EU | AP | CN  (also accepts NORTH_AMERICA, EUROPE, ASIA_PACIFIC, CHINA)
AGORA_AREA=US

# ── Agora-managed models (optional — defaults shown) ─────────────────────
# Speech-to-text (Deepgram)
SDK_ASR_MODEL=nova-3
# "en" = English only. Try "multi" for mixed English/Hindi speech.
ASR_LANGUAGE=en

# LLM (OpenAI)
SDK_LLM_MODEL=gpt-4o-mini

# Text-to-speech (MiniMax)
SDK_TTS_MODEL=speech-2.8-turbo
SDK_TTS_VOICE_ID=English_radiant_girl
